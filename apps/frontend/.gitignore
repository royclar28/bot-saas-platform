# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Testing ---
/coverage

# --- Next.js ---
/.next/
/out/
/build

# --- System & Misc ---
.DS_Store
*.pem
Thumbs.db
Desktop.ini

# --- Logs & Debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment Variables (CRÍTICO: NO SUBIR NUNCA) ---
.env
.env*.local
.env.production
.env.development
.env.test

# --- Vercel ---
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Prisma ---
# Ignoramos el cliente generado para obligar a regenerarlo en cada install
/src/generated/prisma

# --- ALMACENAMIENTO LOCAL (NUEVO) ---
# Ignoramos todas las fotos subidas localmente...
public/uploads/*
# ...PERO mantenemos el archivo .gitkeep para que Git cree la carpeta vacía en el servidor
!public/uploads/.gitkeep

# --- IDEs (Opcional) ---
.vscode/
.idea/evidencias/
